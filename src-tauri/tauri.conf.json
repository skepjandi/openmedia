{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMedia",
  "version": "1.0.4",
  "identifier": "surf.openmedia",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMedia",
        "width": 1100,
        "height": 760,
        "minWidth": 560,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "17.0",
      "bundleVersion": "1016"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "1016"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1016
    },
    "category": "Utility",
    "publisher": "OpenMedia contributors",
    "copyright": "Copyright © OpenMedia contributors",
    "license": "MPL-2.0",
    "licenseFile": "../LICENSE",
    "shortDescription": "Load any website and reshape it with declarative recipes"
  }
}
