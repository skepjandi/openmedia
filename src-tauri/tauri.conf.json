{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMedia",
  "version": "0.1.0",
  "identifier": "surf.openmedia",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMedia",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "17.0",
      "bundleVersion": "1000"
    },
    "macOS": {
      "bundleVersion": "1000"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1000
    }
  }
}
