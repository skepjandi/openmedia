{
  "name": "openmedia",
  "private": true,
  "license": "MPL-2.0",
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "dev:ios": "tauri ios dev",
    "dev:android": "tauri android dev",
    "dev:desktop": "tauri dev",
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "ota": "node scripts/ota.mjs",
    "build:web": "yarn icons:fetch && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "ts:check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "test:swift": "sh scripts/test-domain-scope.sh",
    "test:android": "cd src-tauri/gen/android && ./gradlew :tauri-plugin-siteview:testDebugUnitTest",
    "check:web": "yarn ts:check && yarn lint && yarn format:check && yarn suffix:check && yarn test",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && yarn test:rust",
    "verify": "yarn check:web && yarn check:rust",
    "icons:fetch": "node scripts/fetch-site-icons.mjs",
    "suffix:update": "node scripts/public-suffix.mjs update",
    "suffix:check": "node scripts/public-suffix.mjs check"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skepjandi/openmedia.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22"
}
