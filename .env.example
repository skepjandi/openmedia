# Dev only (ignored in production builds): keep the splash screen visible for at least N seconds.
VITE_SPLASH_MIN_SECONDS=3

# RevenueCat public SDK keys, read at build time from the environment or this file. A missing,
# empty or <PLACEHOLDER> value means purchases are not configured: the app stays Free and
# Restore Purchases reports an error.
OPENMEDIA_RC_KEY_IOS=appl_<PLACEHOLDER>
# The Mac app is the same App Store app as the iPhone one, so it uses the iOS key above unless
# this gives it its own `appl_` key.
# OPENMEDIA_RC_KEY_MACOS=appl_<PLACEHOLDER>
OPENMEDIA_RC_KEY_ANDROID=goog_<PLACEHOLDER>

# Dev only (debug builds, ignored in release): force the entitlement to `pro` or `free` so a
# simulator can test both states without a store account.
# OPENMEDIA_DEV_ENTITLEMENT=pro

# Public HTTPS legal pages shown in the paywall. Purchases stay disabled until both URLs point
# to live pages; the default landing site does not currently publish either page.
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_URL=

# Sharing service (a Cloudflare Worker), read at build time. Without it the Share button is hidden;
# the recipe library, import and export still work. HTTPS only (plain http to localhost in debug
# builds). It never holds a secret: GitHub sign-in happens on the Worker.
OPENMEDIA_SHARE_URL=

# Release tooling (`yarn release doctor`; docs/wiki/store-builds.md#releasing-yarn-release).
# Certificates and profiles are discovered from the login keychain and the signing folder, so
# normally only the p12 password is needed, and only on a Mac that has not imported the .p12 files.
# SIGNING_DIR=~/Documents/openmedia-signing
# SIGNING_P12_PASSWORD=
# The login password; lets `yarn release setup` allow codesign to use the keys without a prompt.
# KEYCHAIN_PASSWORD=
# App Store Connect API key (optional): latest-build lookup and `--validate`.
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_PATH=~/path/to/AuthKey_XXXXXXXXXX.p8
