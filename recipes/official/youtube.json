{
  "schema": 1,
  "id": "market.official.youtube",
  "name": "YouTube",
  "version": "2.1.0",
  "origin": "user",
  "tags": ["desktop", "mobile"],
  "match": ["https://*.youtube.com/*"],
  "options": [
    {
      "id": "open-app",
      "label": "Hide the Open App button",
      "description": "The Open App button in the header of a video page.",
      "group": "annoyance",
      "default": true
    },
    {
      "id": "promos",
      "label": "Hide promo banners",
      "description": "Premium, survey and \"get the app\" banners and pop-ups.",
      "group": "annoyance",
      "default": true
    },
    {
      "id": "ads",
      "label": "Hide ad slots",
      "description": "Hides separate companion and promoted ad slots when present; it cannot block ads playing inside videos.",
      "group": "annoyance",
      "default": true
    },
    {
      "id": "premium-upsell",
      "label": "Hide YouTube Premium prompts",
      "description": "The Premium banner on the home page and the Premium rows in the sidebar.",
      "group": "annoyance",
      "default": true
    },
    {
      "id": "shorts",
      "label": "Hide Shorts",
      "description": "The Shorts tab, Shorts shelves and cards in Home, search and video pages, and the Shorts tab on channels. A Shorts address can still be opened directly.",
      "group": "content",
      "default": false
    },
    {
      "id": "home-feed",
      "label": "Hide Home recommendations",
      "description": "Empties the Home feed. The search box stays.",
      "group": "content",
      "default": false
    },
    {
      "id": "home-chips",
      "label": "Hide topic chips",
      "description": "The All, Music, Live row on Home.",
      "group": "content",
      "default": false
    },
    {
      "id": "comments",
      "label": "Hide comments",
      "description": "The comments entry under a video.",
      "group": "content",
      "default": false
    },
    {
      "id": "related",
      "label": "Hide up next videos",
      "description": "The suggested videos below a video.",
      "group": "content",
      "default": false
    },
    {
      "id": "playlists",
      "label": "Hide Mixes and playlists in lists",
      "description": "Mix and playlist cards in search and suggestions.",
      "group": "content",
      "default": false
    },
    {
      "id": "sidebar-more",
      "label": "Hide More from YouTube",
      "description": "The sidebar section with Premium, Music, Kids and the footer links.",
      "group": "content",
      "default": false
    },
    {
      "id": "end-cards",
      "label": "Hide end-screen suggestions",
      "description": "The video thumbnails that cover the player near the end and when paused.",
      "group": "content",
      "default": false
    },
    {
      "id": "live-chat",
      "label": "Hide live chat",
      "description": "The chat box beside live streams and premieres.",
      "group": "content",
      "default": false
    },
    {
      "id": "shopping",
      "label": "Hide merch, tickets and info boxes",
      "description": "Merch and ticket shelves and the fact-check boxes under a video.",
      "group": "content",
      "default": false
    },
    {
      "id": "topbar-buttons",
      "label": "Hide Create and voice search",
      "description": "The Create button and the microphone beside the search box.",
      "group": "content",
      "default": false
    },
    {
      "id": "notifications",
      "label": "Hide the notification bell",
      "description": "The bell and its unread count in the top bar.",
      "group": "content",
      "default": false
    },
    {
      "id": "library-tabs",
      "label": "Hide the Subscriptions and You tabs",
      "description": "Those tabs in the bottom bar on a phone.",
      "group": "content",
      "default": false
    },
    {
      "id": "thumbnails",
      "label": "Video thumbnails",
      "description": "Show thumbnails as they are, blur them, or hide them in lists, search results and suggestions.",
      "group": "content",
      "choices": [
        {
          "id": "show",
          "label": "Show"
        },
        {
          "id": "blur",
          "label": "Blur"
        },
        {
          "id": "hide",
          "label": "Hide"
        }
      ],
      "default": "show"
    },
    {
      "id": "video-titles",
      "label": "Video titles",
      "description": "Blur video titles in lists and suggestions to dodge clickbait. The title above the playing video stays readable.",
      "group": "content",
      "choices": [
        {
          "id": "show",
          "label": "Show"
        },
        {
          "id": "blur",
          "label": "Blur"
        }
      ],
      "default": "show"
    },
    {
      "id": "channel-avatars",
      "label": "Hide channel and commenter avatars",
      "description": "The round channel pictures on video cards and beside comments.",
      "group": "content",
      "default": false
    },
    {
      "id": "video-stats",
      "label": "Hide view, like and subscriber counts",
      "description": "View counts on cards and under the video, the like number and the subscriber count. English labels only on phones.",
      "group": "content",
      "default": false
    },
    {
      "id": "hashtags",
      "label": "Hide hashtag links",
      "description": "The #hashtag links above a video title and inside its description.",
      "group": "content",
      "default": false
    },
    {
      "id": "subscribe-buttons",
      "label": "Hide Subscribe buttons",
      "description": "The Subscribe button on a video page and in channel results.",
      "group": "content",
      "default": false
    },
    {
      "id": "action-buttons",
      "label": "Hide Share, Save and Download buttons",
      "description": "The Share, Save and Download buttons under a video. Like and Dislike stay.",
      "group": "content",
      "default": false
    },
    {
      "id": "player-overlays",
      "label": "Hide video info cards and watermark",
      "description": "The i cards teaser and button and the channel watermark inside the player. The controls stay.",
      "group": "content",
      "default": false
    },
    {
      "id": "comments-look",
      "label": "Comments style",
      "description": "Fade or blur the comments instead of hiding them. Hide comments overrides it.",
      "group": "content",
      "choices": [
        {
          "id": "show",
          "label": "Show"
        },
        {
          "id": "dim",
          "label": "Dim"
        },
        {
          "id": "blur",
          "label": "Blur"
        }
      ],
      "default": "show"
    },
    {
      "id": "related-look",
      "label": "Up next style",
      "description": "Fade or blur the suggested videos instead of hiding them. Hide up next videos overrides it.",
      "group": "content",
      "choices": [
        {
          "id": "show",
          "label": "Show"
        },
        {
          "id": "dim",
          "label": "Dim"
        },
        {
          "id": "blur",
          "label": "Blur"
        }
      ],
      "default": "show"
    },
    {
      "id": "home-feed-look",
      "label": "Home feed style",
      "description": "Fade or blur the Home recommendations instead of hiding them. Hide Home recommendations overrides it.",
      "group": "content",
      "choices": [
        {
          "id": "show",
          "label": "Show"
        },
        {
          "id": "dim",
          "label": "Dim"
        },
        {
          "id": "blur",
          "label": "Blur"
        }
      ],
      "default": "show"
    },
    {
      "id": "search-shelves",
      "label": "Hide extra shelves in search",
      "description": "Horizontal shelves between search results (Music, Latest from, People also watched). Normal results stay.",
      "group": "content",
      "default": false
    },
    {
      "id": "mini-player",
      "label": "Hide the mini player",
      "description": "The small floating player that follows you when you scroll away from a video on desktop.",
      "group": "content",
      "default": false
    }
  ],
  "rules": [
    {
      "id": "open-app-pill",
      "label": "Open App button in the header",
      "type": "hide",
      "option": "open-app",
      "target": {
        "css": "ytm-mobile-topbar-renderer ytm-button-renderer:has(> a[href^=\"vnd.youtube://\"])"
      }
    },
    {
      "id": "promo-banners",
      "label": "Promo, statement and upsell banners",
      "type": "hide",
      "option": "promos",
      "target": {
        "css": "ytm-mealbar-promo-renderer, ytm-statement-banner-renderer, ytm-upsell-dialog-renderer, ytm-brand-video-singleton-renderer"
      }
    },
    {
      "id": "companion-slot",
      "label": "Companion ad slot",
      "type": "hide",
      "option": "ads",
      "target": {
        "css": "ytm-companion-slot"
      }
    },
    {
      "id": "promoted-tiles",
      "label": "Promoted tiles and masthead ads",
      "type": "hide",
      "option": "ads",
      "target": {
        "css": "ytm-promoted-sparkles-web-renderer, ytm-promoted-video-renderer, ytm-ad-slot-renderer, ytm-masthead-ad-renderer"
      }
    },
    {
      "id": "shorts-tab",
      "label": "Shorts tab in the bottom bar",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytm-pivot-bar-item-renderer:has(.pivot-shorts)"
      }
    },
    {
      "id": "shorts-home-shelf",
      "label": "Shorts shelves on Home",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytm-rich-section-renderer:has(ytm-shorts-lockup-view-model)"
      }
    },
    {
      "id": "shorts-search-shelf",
      "label": "Shorts shelves in search",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "grid-shelf-view-model:has(ytm-shorts-lockup-view-model)"
      }
    },
    {
      "id": "shorts-search-card",
      "label": "Single Shorts cards in search",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytm-video-with-context-renderer:has(a[href^=\"/shorts/\"])"
      }
    },
    {
      "id": "shorts-related-shelf",
      "label": "Shorts shelf under a video",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytm-reel-shelf-renderer"
      }
    },
    {
      "id": "shorts-channel-tab",
      "label": "Shorts tab on channels",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "yt-tab-shape[tab-title=\"Shorts\"]"
      }
    },
    {
      "id": "shorts-chip",
      "label": "Shorts chip on Home",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytm-chip-cloud-chip-renderer:has([aria-label=\"Shorts\"])"
      }
    },
    {
      "id": "home-feed",
      "label": "Home recommendations",
      "type": "hide",
      "option": "home-feed",
      "target": {
        "css": "ytm-browse:not(:has(yt-page-header-renderer)) ytm-rich-grid-renderer .rich-grid-renderer-contents"
      }
    },
    {
      "id": "home-chips",
      "label": "Topic chips",
      "type": "hide",
      "option": "home-chips",
      "target": {
        "css": "ytm-feed-filter-chip-bar-renderer"
      }
    },
    {
      "id": "comments-entry",
      "label": "Comments entry under a video",
      "type": "hide",
      "option": "comments",
      "target": {
        "css": "ytm-item-section-renderer:has(> lazy-list > yt-video-metadata-carousel-view-model[aria-label=\"Comments\"])"
      }
    },
    {
      "id": "related-videos",
      "label": "Suggested videos below a video",
      "type": "hide",
      "option": "related",
      "target": {
        "css": ".related-items-container"
      }
    },
    {
      "id": "playlist-cards",
      "label": "Playlist cards",
      "type": "hide",
      "option": "playlists",
      "target": {
        "css": "ytm-compact-playlist-renderer"
      }
    },
    {
      "id": "mix-cards",
      "label": "Mix cards",
      "type": "hide",
      "option": "playlists",
      "target": {
        "css": "ytm-compact-radio-renderer"
      }
    },
    {
      "id": "promo-banners-desktop",
      "label": "Premium and promo banners",
      "type": "hide",
      "option": "promos",
      "target": {
        "css": "ytd-statement-banner-renderer, ytd-banner-promo-renderer, ytd-mealbar-promo-renderer, ytd-brand-video-singleton-renderer, ytd-brand-video-shelf-renderer, ytd-primetime-promo-renderer"
      }
    },
    {
      "id": "premium-guide-entry",
      "label": "Premium rows in the sidebar",
      "type": "hide",
      "option": "premium-upsell",
      "target": {
        "css": "ytd-guide-entry-renderer:has(a[href*=\"premium\"]), ytd-mini-guide-entry-renderer:has(a[href*=\"premium\"])"
      }
    },
    {
      "id": "premium-buttons",
      "label": "Get Premium buttons",
      "type": "hide",
      "option": "premium-upsell",
      "target": {
        "css": "ytd-button-renderer:has(a[href*=\"premium\"]), ytd-statement-banner-renderer"
      }
    },
    {
      "id": "ad-slots-desktop",
      "label": "Ad slots in feeds and next to the player",
      "type": "hide",
      "option": "ads",
      "target": {
        "css": "ytd-ad-slot-renderer, ytd-in-feed-ad-layout-renderer, ytd-display-ad-renderer, ytd-promoted-sparkles-web-renderer, ytd-promoted-video-renderer, ytd-compact-promoted-video-renderer, ytd-action-companion-ad-renderer"
      }
    },
    {
      "id": "ad-containers-desktop",
      "label": "Masthead and player ad containers",
      "type": "hide",
      "option": "ads",
      "target": {
        "css": "#masthead-ad, #player-ads, ytd-companion-slot-renderer, ytd-engagement-panel-section-list-renderer[target-id=\"engagement-panel-ads\"], ytd-search-pyv-renderer"
      }
    },
    {
      "id": "ad-feed-tiles",
      "label": "Feed tiles that only hold an ad",
      "type": "hide",
      "option": "ads",
      "target": {
        "css": "ytd-rich-item-renderer:has(ytd-ad-slot-renderer), ytd-rich-section-renderer:has(ytd-statement-banner-renderer)"
      }
    },
    {
      "id": "shorts-guide-entry",
      "label": "Shorts in the sidebar",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytd-guide-entry-renderer:has(a[title=\"Shorts\"]), ytd-mini-guide-entry-renderer:has(a[title=\"Shorts\"])"
      }
    },
    {
      "id": "shorts-desktop-shelves",
      "label": "Shorts shelves in the home feed",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytd-rich-section-renderer:has(ytd-rich-shelf-renderer[is-shorts]), ytd-rich-shelf-renderer[is-shorts], ytd-reel-shelf-renderer"
      }
    },
    {
      "id": "shorts-desktop-feed-items",
      "label": "Shorts among the home feed videos",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytd-rich-item-renderer:has(a[href^=\"/shorts/\"])"
      }
    },
    {
      "id": "home-feed-desktop",
      "label": "Home page videos",
      "type": "hide",
      "option": "home-feed",
      "target": {
        "css": "ytd-browse[page-subtype=\"home\"] ytd-rich-grid-renderer > #contents"
      }
    },
    {
      "id": "home-chips-desktop",
      "label": "Topic chips above the feed",
      "type": "hide",
      "option": "home-chips",
      "target": {
        "css": "ytd-feed-filter-chip-bar-renderer"
      }
    },
    {
      "id": "comments-desktop",
      "label": "Comments under a video",
      "type": "hide",
      "option": "comments",
      "target": {
        "css": "ytd-comments#comments, ytd-comments-entry-point-header-renderer"
      }
    },
    {
      "id": "related-desktop",
      "label": "Up next column",
      "type": "hide",
      "option": "related",
      "target": {
        "css": "ytd-watch-next-secondary-results-renderer"
      }
    },
    {
      "id": "playlist-cards-desktop",
      "label": "Playlists and Mixes in lists",
      "type": "hide",
      "option": "playlists",
      "target": {
        "css": "ytd-playlist-renderer, ytd-compact-playlist-renderer, ytd-compact-radio-renderer, ytd-radio-renderer, ytd-grid-playlist-renderer"
      }
    },
    {
      "id": "mix-lockups",
      "label": "Mixes shown as video cards",
      "type": "hide",
      "option": "playlists",
      "target": {
        "css": "yt-lockup-view-model:has(a[href*=\"list=RD\"])"
      }
    },
    {
      "id": "sidebar-more-section",
      "label": "More from YouTube sidebar section",
      "type": "hide",
      "option": "sidebar-more",
      "target": {
        "css": "ytd-guide-section-renderer:has(a[href=\"/premium\"]), ytd-guide-renderer #footer"
      }
    },
    {
      "id": "end-cards-overlay",
      "label": "End-screen cards over the player",
      "type": "hide",
      "option": "end-cards",
      "target": {
        "css": ".ytp-ce-element, .ytp-ce-covering-overlay, .ytp-endscreen-content, .ytp-pause-overlay, .ytp-suggestion-set"
      }
    },
    {
      "id": "live-chat-frame",
      "label": "Live chat",
      "type": "hide",
      "option": "live-chat",
      "target": {
        "css": "ytd-live-chat-frame"
      }
    },
    {
      "id": "shopping-shelves",
      "label": "Merch, ticket and product shelves",
      "type": "hide",
      "option": "shopping",
      "target": {
        "css": "ytd-merch-shelf-renderer, ytd-ticket-shelf-renderer, ytd-product-list-renderer, ytd-donation-shelf-renderer"
      }
    },
    {
      "id": "info-panels",
      "label": "Information boxes under a video",
      "type": "hide",
      "option": "shopping",
      "target": {
        "css": "ytd-info-panel-container-renderer, #clarify-box"
      }
    },
    {
      "id": "create-button",
      "label": "Create button",
      "type": "hide",
      "option": "topbar-buttons",
      "target": {
        "css": "ytd-masthead #buttons > ytd-button-renderer:has(button[aria-label=\"Create\"])"
      }
    },
    {
      "id": "voice-search",
      "label": "Voice search button",
      "type": "hide",
      "option": "topbar-buttons",
      "target": {
        "css": "#voice-search-button"
      }
    },
    {
      "id": "notification-bell",
      "label": "Notification bell",
      "type": "hide",
      "option": "notifications",
      "target": {
        "css": "ytd-notification-topbar-button-renderer"
      }
    },
    {
      "id": "shorts-search-items",
      "label": "Shorts among search results",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytd-video-renderer:has(a[href^=\"/shorts/\"])"
      }
    },
    {
      "id": "shorts-related-items",
      "label": "Shorts among related videos",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytd-compact-video-renderer:has(a[href^=\"/shorts/\"])"
      }
    },
    {
      "id": "shorts-grid-items",
      "label": "Shorts in channel video grids",
      "type": "hide",
      "option": "shorts",
      "target": {
        "css": "ytd-grid-video-renderer:has(a[href^=\"/shorts/\"])"
      }
    },
    {
      "id": "library-tab-you",
      "label": "You tab in the bottom bar",
      "type": "hide",
      "option": "library-tabs",
      "target": {
        "css": "ytm-pivot-bar-item-renderer:has(.pivot-you)"
      }
    },
    {
      "id": "library-tab-subs",
      "label": "Subscriptions tab in the bottom bar",
      "type": "hide",
      "option": "library-tabs",
      "target": {
        "css": "ytm-pivot-bar-item-renderer:has(.pivot-subs)"
      }
    },
    {
      "id": "thumbnails-blur-mobile",
      "label": "Thumbnails on a phone",
      "type": "css",
      "option": "thumbnails",
      "choice": ["blur"],
      "target": {
        "css": "ytm-thumbnail-cover img, ytm-compact-thumbnail img, yt-thumbnail-view-model img"
      },
      "declarations": {
        "filter": "blur(12px)"
      }
    },
    {
      "id": "thumbnails-blur-desktop",
      "label": "Thumbnails on desktop",
      "type": "css",
      "option": "thumbnails",
      "choice": ["blur"],
      "target": {
        "css": "ytd-thumbnail:not(.player-container-background-image) img, yt-thumbnail-view-model img"
      },
      "declarations": {
        "filter": "blur(12px)"
      }
    },
    {
      "id": "thumbnails-hide-mobile",
      "label": "Thumbnails on a phone",
      "type": "hide",
      "option": "thumbnails",
      "choice": ["hide"],
      "target": {
        "css": "ytm-thumbnail-cover, ytm-compact-thumbnail, yt-thumbnail-view-model"
      }
    },
    {
      "id": "thumbnails-hide-desktop",
      "label": "Thumbnails on desktop",
      "type": "hide",
      "option": "thumbnails",
      "choice": ["hide"],
      "target": {
        "css": "ytd-thumbnail:not(.player-container-background-image), yt-thumbnail-view-model"
      }
    },
    {
      "id": "titles-blur-mobile",
      "label": "Titles on a phone",
      "type": "css",
      "option": "video-titles",
      "choice": ["blur"],
      "target": {
        "css": "ytm-media-item h3, ytm-compact-video-renderer h4"
      },
      "declarations": {
        "filter": "blur(6px)"
      }
    },
    {
      "id": "titles-blur-desktop",
      "label": "Titles on desktop",
      "type": "css",
      "option": "video-titles",
      "choice": ["blur"],
      "target": {
        "css": "yt-lockup-view-model h3, ytd-video-renderer h3, ytd-compact-video-renderer h3"
      },
      "declarations": {
        "filter": "blur(6px)"
      }
    },
    {
      "id": "avatars-mobile",
      "label": "Channel avatars on video cards and the comments teaser",
      "type": "hide",
      "option": "channel-avatars",
      "target": {
        "css": "div:has(> ytw-channel-thumbnail-with-link-renderer), comments-entry-point-teaser-view-model avatar-view-model"
      }
    },
    {
      "id": "avatars-desktop",
      "label": "Channel avatars on cards and avatars in comments",
      "type": "hide",
