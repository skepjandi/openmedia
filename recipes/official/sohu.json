{
  "schema": 1,
  "id": "market.official.sohu",
  "name": "Sohu",
  "version": "1.1.0",
  "origin": "user",
  "tags": ["desktop", "mobile"],
  "match": ["https://*.sohu.com/*"],
  "options": [
    {
      "id": "cookie-banners",
      "label": "Hide cookie banners",
      "description": "Cookie-consent dialogs from the common consent platforms. The site may still lock scrolling.",
      "group": "annoyance",
      "default": true
    },
    {
      "id": "ads",
      "label": "Hide ads",
      "description": "Google ad slots and ad iframes.",
      "group": "annoyance",
      "default": true
    },
    {
      "id": "app-banners",
      "label": "Hide app install banners",
      "description": "The Smart App Banner and install-our-app strips.",
      "group": "annoyance",
      "default": true
    },
    {
      "id": "headline-pictures",
      "label": "Top story pictures",
      "description": "Pictures in the top-story carousel. Blur keeps the layout; Hide removes them.",
      "group": "content",
      "choices": [
        {
          "id": "show",
          "label": "Show"
        },
        {
          "id": "blur",
          "label": "Blur"
        },
        {
          "id": "hide",
          "label": "Hide"
        }
      ],
      "default": "show"
    },
    {
      "id": "hot-tags",
      "label": "Hide hot tags",
      "description": "The row of hot topic tags under the header.",
      "group": "content",
      "default": false
    },
    {
      "id": "live-scores",
      "label": "Hide live scores",
      "description": "The sports live-match box.",
      "group": "content",
      "default": false
    },
    {
      "id": "short-videos",
      "label": "Hide the short video block",
      "description": "The short video plate on the home page.",
      "group": "content",
      "default": false
    },
    {
      "id": "footer-links",
      "label": "Hide footer navigation",
      "description": "The footer navigation list.",
      "group": "content",
      "default": false
    }
  ],
  "rules": [
    {
      "id": "cookie-banners",
      "label": "Cookie consent dialogs",
      "type": "hide",
      "option": "cookie-banners",
      "target": {
        "css": "#onetrust-consent-sdk, #onetrust-banner-sdk, #CybotCookiebotDialog, #qc-cmp2-container, .fc-consent-root, #didomi-host, #usercentrics-root, #truste-consent-track, .osano-cm-window, .cc-window, #cookie-banner, #cookie-notice, #cookieBanner"
      }
    },
    {
      "id": "ad-slots",
      "label": "Ad slots and ad iframes",
      "type": "hide",
      "option": "ads",
      "target": {
        "css": "ins.adsbygoogle, div[id^=\"div-gpt-ad\"], iframe[id^=\"google_ads_iframe\"], iframe[src*=\"doubleclick.net\"], iframe[src*=\"googlesyndication.com\"], div[data-google-query-id]"
      }
    },
    {
      "id": "app-banners",
      "label": "App install banners",
      "type": "hide",
      "option": "app-banners",
      "target": {
        "css": "#smartbanner, .smartbanner, .smart-banner, .app-banner, #app-banner, .app-download-banner, .install-app-banner"
      }
    },
    {
      "id": "sohu-ad-bills",
      "label": "Ad billboards",
      "type": "hide",
      "option": "ads",
      "target": {
        "css": ".cbd-plate-bill"
      }
    },
    {
      "id": "pictures-blur",
      "label": "Top story pictures",
      "type": "css",
      "option": "headline-pictures",
      "choice": [
        "blur"
      ],
      "target": {
        "css": ".cbd-focus-wrapper img"
      },
      "declarations": {
        "filter": "blur(12px)"
      }
    },
    {
      "id": "pictures-hide",
      "label": "Top story pictures",
      "type": "hide",
      "option": "headline-pictures",
      "choice": [
        "hide"
      ],
      "target": {
        "css": ".cbd-focus-wrapper img"
      }
    },
    {
      "id": "hot-tags",
      "label": "Hot tags",
      "type": "hide",
      "option": "hot-tags",
      "target": {
        "css": "section.hot-tags"
      }
    },
    {
      "id": "live-scores",
      "label": "Live scores",
      "type": "hide",
      "option": "live-scores",
      "target": {
        "css": ".recommend-live"
      }
    },
    {
      "id": "short-videos",
      "label": "Short video block",
      "type": "hide",
      "option": "short-videos",
      "target": {
        "css": "#PlateBlockShortvideo"
      }
    },
    {
      "id": "footer-links",
      "label": "Footer navigation",
      "type": "hide",
      "option": "footer-links",
      "target": {
        "css": "footer.footer-navs-wrapper"
      }
    }
  ],
  "meta": {
    "author": "OpenMedia",
    "homepage": "https://www.sohu.com/",
    "summary": "Hides Sohu ad bills; blur or hide top-story pictures; hide hot tags, live scores, short videos and footer links",
    "notes": "Checked 2026-11-13, logged out, iPhone UA 390x844 in headless Chrome, m.sohu.com home page (Chinese interface). Counts are `querySelectorAll` on the rendered DOM saved from that load (scripts then switched off to evaluate): ad billboards `.cbd-plate-bill` 12 (11 marked as ads and one top bar), top story pictures 7, hot tags 1, live scores 1, short video block 1, footer navigation 1. Selectors are Sohu's readable `cbd-` classes and plate ids.\n\nNOT verified: the infinite feed below the fold, article pages, www.sohu.com desktop, signed-in states, the original cookie and app-banner rules (nothing matched).",
    "lastVerified": "2026-11-13"
  }
}
